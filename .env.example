# Next.js (Vercel) — 브라우저에 노출되는 값은 NEXT_PUBLIC_ 만
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_docs_replace_me

# Next.js 서버가 FastAPI로 넘기는 주소 (Vercel Environment Variable)
BACKEND_URL=http://127.0.0.1:8000

# FastAPI (Render) — 서버에만 넣습니다
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
TOSS_SECRET_KEY=test_gsk_docs_replace_me
VWORLD_API_KEY=
DATA_GO_KR_SERVICE_KEY=
FINLIFE_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
PORT=8000
